    private fun fMQuery(s: String? = null, methodName: String? = null, paramTypes: List<String>? = null, classPrefix: String? = null, fieldNames: List<String>? = null, modifiers: Int = 0, returnType: String? = null, strings: List<String>? = null, requireNoStrings: Boolean = false, methodCalls: List<String>? = null, filter: ((String) -> Boolean)? = null): String? {
        try {
            val mm = MethodMatcher.create()
            if (modifiers != 0) mm.modifiers(modifiers)
            paramTypes?.let { mm.paramTypes(it) }
            s?.let { mm.usingStrings(listOf(it)) }
            methodName?.let { mm.name(it) }
            returnType?.let { mm.returnType(it) }
            strings?.let { mm.usingStrings(it) }
            methodCalls?.forEach { c -> mm.addInvoke { name = c } }
            if (classPrefix != null || fieldNames != null) {
                val cm = ClassMatcher.create()
                classPrefix?.let { cm.className(it) }
                fieldNames?.forEach { f -> cm.addField { name = f } }
                mm.declaredClass(cm)
            }
            val res = bridge?.findMethod(FindMethod.create().matcher(mm)) ?: return null
            for (method in res) {
                if (requireNoStrings && method.usingStrings.isNotEmpty()) continue
                val rt = method.returnType.toString()
                if (filter?.invoke(rt) ?: true) return method.descriptor
            }
        } catch (e: Exception) { }
        return null
    }

    private fun fM(s: String): String? = fMQuery(s = s)
    private fun fM(p: List<String>, r: String? = null): String? = fMQuery(paramTypes = p, returnType = r)
    private fun fM(ss: List<String>): String? = fMQuery(strings = ss)
    private fun fM(cn: String, mn: String): String? = fMQuery(classPrefix = cn, methodName = mn)

    // --- 适配 2.0.7 修复：彻底回归原始写法 ---
    private fun fC(className: String): String? {
        val b = bridge ?: return null
        return try {
            val res = b.findClass(FindClass.create().matcher(ClassMatcher.create().name(className)))
            val target = res.firstOrNull() ?: return null
            "L${target.toString().replace(".", "/")};"
        } catch (e: Exception) { null }
    }

    private fun fCByStrings(vararg ss: String): String? {
        val b = bridge ?: return null
        return try {
            val res = b.findClass(FindClass.create().matcher(ClassMatcher.create().usingStrings(ss.toList())))
            val target = res.firstOrNull() ?: return null
            "L${target.toString().replace(".", "/")};"
        } catch (e: Exception) { null }
    }

    private fun fCByPattern(p: String): String? {
        val b = bridge ?: return null
        return try {
            val res = b.findClass(FindClass.create().matcher(ClassMatcher.create().className(p)))
            val target = res.firstOrNull() ?: return null
            "L${target.toString().replace(".", "/")};"
        } catch (e: Exception) { null }
    }

    // 辅助 API
    private fun fMX(s: String, mod: Int, name: String? = null, p: List<String>? = null): String? = fMQuery(s = s, modifiers = mod, methodName = name, paramTypes = p)
    private fun fMStatic(s: String, p: List<String>? = null) = fMX(s, 8, p = p)
    private fun fMPrivate(s: String) = fMX(s, 2)
    private fun fMConstructor(s: String, p: List<String>? = null) = fMX(s, 0, "<init>", p)
    private fun fMSync(s: String) = fMX(s, 32)
    private fun fMAbstract(s: String) = fMX(s, 1024)
    private fun fMReturnType(rt: String, s: String? = null) = fMQuery(returnType = rt, s = s)
    private fun fMCaller(cd: String) = fMQuery(s = cd)
    private fun fMInClass(cn: String, s: String) = fMQuery(classPrefix = cn, s = s)
    private fun fMNative(s: String) = fMX(s, 256)
    private fun fMFinal(s: String) = fMX(s, 16)
    private fun fMGeneric(s: String): String? = try {
        val res = bridge?.findMethod(FindMethod.create().matcher(MethodMatcher.create().usingStrings(listOf(s))))
        res?.firstOrNull { it.descriptor?.contains("<") == true }?.descriptor
    } catch (e: Exception) { null }
    
    private fun fMSingleton(): String? = fMQuery(methodName = "getInstance", modifiers = 9, returnType = "L.*;")
    private fun fMBuilder(s: String = "build"): String? = fMQuery(methodName = s, returnType = "L.*Builder;")
    private fun fMListener(): String? = fMQuery(methodName = "set.*Listener", paramTypes = listOf("L.*Listener;"))
    private fun fMEvent(en: String): String? = fMQuery(methodName = en, paramTypes = listOf("Landroid/view/View;"))
    private fun fMBind(s: String): String? = fMQuery(methodName = ".*bind.*", s = s)
    private fun fMInit(s: String = "init"): String? = fMQuery(methodName = ".*$s.*", modifiers = 1)

    private fun save(k: String, v: String?) {
        if (!v.isNullOrEmpty()) {
            LogUtils.logI("${gT()}: Saving result for '$k' -> $v")
            MMKVManager.putString(k, v); dispatchRealtime(k, v)
        } else {
            if (k !in silentNullKeys) LogUtils.logW("${gT()}: [" + sF() + "] $k")
            MMKVManager.remove(k)
        }
    }

    private fun dispatchRealtime(k: String, v: String) { when (k) { } }
    private fun loadSo() { if (!isL) try { System.loadLibrary("dexkit"); isL = true } catch (e: Throwable) {} }
    fun clearCache() { allKeys.forEach { MMKVManager.remove(it) }; isI = false }
    fun close() { try { bridge?.close() } catch (e: Exception) {}; bridge = null }
